# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more information.

# Dependencies
/node_modules/
/.pnp/
.pnp.*

# Package manager logs and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/.pnpm-store/

# Compiled output and build caches
/dist/
/tmp/
/out-tsc/
/bazel-out/
/.angular/cache/
/.sass-cache/
*.tsbuildinfo

# Test and coverage output
/coverage/
/test-results/
/playwright-report/
/blob-report/
__screenshots__/
testem.log

# Environment files and local secrets
.env
.env.*
!.env.template

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# Miscellaneous local files
/connect.lock
/typings/
*.log
libpeerconnection.log

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
supabase/.temp/
supabase/.branches/
