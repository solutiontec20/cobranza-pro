{
  "name": "cobranza-pro",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "preview:cf": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "test:ci": "ng test --no-watch --no-progress",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "db:types": "supabase gen types typescript --local --schema public > src/app/core/supabase/database.types.ts"
  },
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@primeicons/angular": "8.0.2",
    "@primeuix/themes": "3.0.1",
    "@supabase/supabase-js": "2.117.2",
    "chart.js": "4.5.1",
    "exceljs": "4.4.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "primeicons": "8.0.2",
    "primelocale": "2.5.0",
    "primeng": "22.1.2",
    "rxjs": "~7.8.0",
    "tailwindcss-primeui": "0.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@ngx-env/builder": "^22.0.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "26.6.4",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "supabase": "2.119.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wrangler": "4.149.0"
  }
}
